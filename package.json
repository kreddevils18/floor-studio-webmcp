{
  "name": "floor-studio-webmcp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "wasm:build": "wasm-pack build wasm/floor-core --target web --out-dir pkg --release",
    "build:app": "tsc -b && vite build",
    "build": "bun run wasm:build && bun run build:app",
    "check": "biome check . && tsc -b --pretty false",
    "check:fix": "biome check --write .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "verify": "bun run check && bun run test:coverage && bun run build && bun run test:e2e"
  },
  "dependencies": {
    "@mcp-b/webmcp-types": "5.0.3",
    "@react-three/fiber": "9.4.2",
    "idb": "8.0.3",
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.7.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "fake-indexeddb": "6.2.4",
    "jsdom": "27.0.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wasm-pack": "0.15.0"
  }
}
