{
  "name": "floor-studio-webmcp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "wasm:build": "wasm-pack build wasm/floor-core --target web --out-dir pkg --release",
    "build": "npm run wasm:build && tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@mcp-b/webmcp-types": "5.0.3",
    "idb": "8.0.3",
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.7.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@webgpu/types": "0.1.72",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.20",
    "fake-indexeddb": "6.2.4",
    "globals": "16.4.0",
    "jsdom": "27.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wasm-pack": "0.15.0"
  }
}
